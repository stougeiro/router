{
    "name": "stougeiro/router",
    "description": "Minimalist, high-performance router for PHP 8.2+ focused exclusively on route resolution. Returns controller + variables with dual cache support (file/sqlite), PHPStan Level 9 compliance, and strict separation of responsibilities.",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "stougeiro",
            "email": "sidneytougeiro@gmail.com"
        }
    ],
    "keywords": [
        "router",
        "routing",
        "route",
        "route-matching",
        "route-resolution",
        "http",
        "psr-7",
        "cache",
        "sqlite",
        "file-cache",
        "phpstan",
        "type-safe",
        "framework-agnostic",
        "declarative-routing",
        "modular-routing",
        "performance"
    ],
    "support": {
        "issues": "https://github.com/stougeiro/router/issues",
        "source": "https://github.com/stougeiro/router"
    },
    "funding": [
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/stougeiro"
        }
    ],
    "autoload": {
        "psr-4": {
            "STDW\\Http\\Router\\": "src/"
        },
        "files": [
            "src/Helper/helper.php"
        ]
    },
    "require": {
        "php": ">=8.2",
        "stougeiro/router-contract": "^2.0",
        "stougeiro/cache-contract": "^1.0",
        "stougeiro/support": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "pestphp/pest": "^3.8",
        "stougeiro/cache": "^2.0",
        "stougeiro/http": "^2.1"
    },
    "scripts": {
        "stan": "vendor/bin/phpstan",
        "pest": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
